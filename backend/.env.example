# ============================================================
# NFT Trading Bot - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- OpenSea API ---
OPENSEA_API_KEY=your_opensea_api_key_here
OPENSEA_API_BASE=https://api.opensea.io/api/v2

# --- Ethereum / Wallet ---
# Your wallet private key (KEEP SECRET - never commit this!)
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Ethereum RPC endpoint (Alchemy, Infura, etc.)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key_here

# --- Trading Parameters ---
# Maximum ETH to spend per NFT buy
MAX_BUY_PRICE_ETH=0.5

# Minimum profit margin to trigger a sell (e.g., 0.02 = 2%)
MIN_PROFIT_MARGIN=0.02

# Maximum ETH budget for the bot (safety cap)
MAX_BUDGET_ETH=2.0

# Bid amount as fraction of floor price (e.g., 0.85 = bid 85% of floor)
BID_FRACTION=0.85

# How many NFTs to hold at once max
MAX_PORTFOLIO_SIZE=10

# --- Scanner Settings ---
# How often to scan OpenSea (in seconds)
SCAN_INTERVAL_SECONDS=60

# Minimum 24h volume for a collection to be considered (in ETH)
MIN_COLLECTION_VOLUME=1

# Minimum floor price in ETH
MIN_FLOOR_PRICE=0.05

# Maximum floor price in ETH
MAX_FLOOR_PRICE=2.0

# --- Server ---
PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Bot Mode ---
# true = bot will auto-execute trades; false = manual approval required
AUTO_TRADE=false

# --- Dashboard Security ---
# Password required to access the UI and all API routes (leave blank to disable)
DASHBOARD_PASSWORD=your_strong_password_here
